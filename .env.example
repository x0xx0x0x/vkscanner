# VK Scanner environment configuration
# Copy to .env and adjust as needed

# Backend
BACKEND_PORT=8000
PYTHONUNBUFFERED=1

# Frontend
FRONTEND_PORT=3000

# Brute-force limits
BRUTEFORCE_MAX_ATTEMPTS=10000
BRUTEFORCE_TIMEOUT_SECONDS=60

# WHOIS lookups (set to "true" to enable, disabled by default)
ENABLE_WHOIS=false
